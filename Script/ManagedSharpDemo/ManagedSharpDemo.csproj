<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Import Project="..\..\Plugins\UnrealSharp\UnrealSharp.Shared.props" />
  <ItemGroup>
    <ProjectReference Include="../GameHost/GameHost.csproj" />
    <!-- Generated game-module bindings (UnrealSharp.SharpDemo namespace).
         Emitted by UHT to Binaries/Managed/net10.0/SharpDemo.dll.
         The legacy "..\SharpDemo.Glue\SharpDemo.Glue.csproj" reference pointed at a
         hand-written glue project that no longer exists in the current layout. -->
    <Reference Include="SharpDemo">
      <HintPath>..\..\Binaries\Managed\net10.0\SharpDemo.dll</HintPath>
    </Reference>
    <!-- Generated bindings for the RuntimeWidgetLayout module (JSON → UMG). -->
    <Reference Include="RuntimeWidgetLayout">
      <HintPath>..\..\Binaries\Managed\net10.0\RuntimeWidgetLayout.dll</HintPath>
    </Reference>
    <!-- Generic runtime video bindings, also shared with dynamically loaded games. -->
    <Reference Include="RuntimeBinkVideo">
      <HintPath>../../Binaries/Managed/net10.0/RuntimeBinkVideo.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>