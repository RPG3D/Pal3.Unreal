# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
**/SharpDemo.sln
**/SharpDemo.Mixed.sln

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

Script/obj/*
Script/bin/*
Script/.idea/*
.idea/*

bin
obj

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

!Build/**/*.bat
!Build/**/*.sh
!Build/**/*.command

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
Plugins/UnrealSharp/

Content/ParagonShinbi/

# Don't include launchSettings (contains local dev paths)
/Script/Properties/launchSettings.json
/Script/ProjectGlue

/Windows/

/ArchivedBuilds/
/Content/Managed/
/MergeScriptSln.exe

# Pal3 port / local tooling
.vscode/
*.bak*
*.pdb
*.log
/build_*.log
/uat_android_step3.log
/talk.txt
/grab_crash.sh
/Automation_SharpDemo.sln
/Automation_SharpDemo.slnx
/SharpDemo.slnx
/SharpDemo.code-workspace
/Script/ManagedSharpDemo.sln.DotSettings.user
/Script/ManagedSharpDemo.sln.bak
/Script/*/Content/
/tools/MergeScriptSln/publish/
/.claude/projects/

# Local packaging output and OS metadata
/Packaged/
.DS_Store

# Per-combo scratch state written by build-android-mac.sh
Config/Android/AndroidEngine.ini
SharpDemo.uproject.DotSettings.user

# build/script artifacts (local)
Archives/
Script/ManagedSharpDemo/pre.xml

# Python bytecode (dev tooling)
__pycache__/
*.pyc
